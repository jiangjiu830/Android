<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- 笔记卡片 -->
    <style name="Widget.NotePad.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerLow</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutlineVariant</item>
        <item name="rippleColor">?attr/colorPrimary</item>
    </style>

    <!-- 列表项标题 -->
    <style name="TextAppearance.NotePad.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- 列表项正文摘要 -->
    <style name="TextAppearance.NotePad.Preview" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- 时间戳等辅助信息 -->
    <style name="TextAppearance.NotePad.Meta" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- 分类 / 置顶 小标签 -->
    <style name="Widget.NotePad.Pill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:textSize">11sp</item>
        <item name="android:background">@drawable/bg_pill</item>
    </style>

    <!-- 设置页分组标题 -->
    <style name="TextAppearance.NotePad.Section" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

</resources>
